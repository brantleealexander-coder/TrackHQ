# Copy this file to .env.local and fill in your values.

# ─────────────────────────────────────────────────────────
# Tenant config — branding + feature toggles for this deployment.
# JSON shape matches the TenantConfig interface in src/lib/tenant-config.ts.
# NEXT_PUBLIC_ so client components can read it; the contents are non-secret.
# See examples/crossmar/tenant_config.json for a real example.
#
# IMPORTANT: wrap the JSON in SINGLE quotes — the `#` inside brand_color
# would otherwise be parsed as a dotenv comment and truncate the value.
# On Vercel, set this as a single env var with the raw JSON (no quotes).
# ─────────────────────────────────────────────────────────
NEXT_PUBLIC_TENANT_CONFIG_JSON='{"business":{"name":"Fleet Operator","logo_url":"","brand_color":"#f97316","site_title":"Fleet Dashboard"},"features":{"visionlink":false,"samsara":false,"quickbooks":false,"chatbot":false}}'

# ─────────────────────────────────────────────────────────
# Supabase — this tenant's project.
# Find these in: Supabase Dashboard → Project Settings → API
# ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Dashboard access — what leadership types to log in.
DASHBOARD_PASSWORD=choose-a-strong-password

# Cookie signing secret — generate with: openssl rand -hex 32
COOKIE_SECRET=generate-a-64-char-hex-string-here

# ─────────────────────────────────────────────────────────
# Optional integrations — only set when the matching feature
# in NEXT_PUBLIC_TENANT_CONFIG_JSON is true.
# ─────────────────────────────────────────────────────────

# Samsara — GPS tracking. Generate at: Samsara dashboard → Settings → API Tokens.
SAMSARA_API_TOKEN=

# Mapbox — required if Fleet Map is enabled.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Anthropic — required for the chat assistant.
ANTHROPIC_API_KEY=
