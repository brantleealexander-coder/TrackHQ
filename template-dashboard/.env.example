# Copy this file to .env.local and fill in your values

# Supabase — same project as the Dispatcher Andy server
# Find these in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Dashboard access password — what leadership types to log in
DASHBOARD_PASSWORD=choose-a-strong-password

# Cookie signing secret — generate with: openssl rand -hex 32
COOKIE_SECRET=generate-a-64-char-hex-string-here

# Samsara — pure GPS tracking for non-Cat equipment
# Generate at: Samsara dashboard → Settings (gear) → API Tokens → Add an API Token
# Default Read scopes already include "Equipment Statistics" which is what we need.
SAMSARA_API_TOKEN=your-samsara-api-token-here
