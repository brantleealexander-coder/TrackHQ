# Copy this file to .env and fill in your values.

# ─────────────────────────────────────────────────────────
# Supabase — this tenant's project (same one as template-dashboard).
# ─────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key-here

# ─────────────────────────────────────────────────────────
# VAPI — the AI voice assistant.
# Generate the key in the VAPI dashboard. Create one assistant per tenant
# and put its UUID in VAPI_ASSISTANT_ID. VAPI_WEBHOOK_URL is the public URL
# of this server's /webhook/vapi endpoint.
# ─────────────────────────────────────────────────────────
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_WEBHOOK_URL=https://your-server.up.railway.app/webhook/vapi

# ─────────────────────────────────────────────────────────
# Google Calendar — only required when business_config.features.google_calendar
# is true. credentials.json and token.json must also be present on disk.
# ─────────────────────────────────────────────────────────
GOOGLE_CALENDAR_ID=primary
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json

# ─────────────────────────────────────────────────────────
# Twilio — only required when features.twilio_sms is true.
# ─────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ─────────────────────────────────────────────────────────
# Telegram — only required when features.telegram_alerts is true.
# ─────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# ─────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────
ENVIRONMENT=development
PORT=8000

# ─────────────────────────────────────────────────────────
# Multi-tenant scoping — single-tenant mode for the launch.
# Webhook tools scope every Supabase read/write to this company_id so the
# agent only sees the demo tenant's assets/bookings. Switch to per-call
# routing (lookup by VAPI assistant_id) once we have >1 paying customer.
# ─────────────────────────────────────────────────────────
DEMO_COMPANY_ID=1
