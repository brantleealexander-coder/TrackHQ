# Copy to provisioning/.env and fill in your values.
# Required for `provision-customer.ts` to actually call external APIs.
# `--dry-run` mode runs without any of these.

# ─────────────────────────────────────────────────────────
# API tokens — operator-personal, never share between operators.
# ─────────────────────────────────────────────────────────

# GitHub personal access token. Needs repo scope + workflow scope (for the
# Actions runs to keep working after fork). Create at:
#   https://github.com/settings/tokens
GITHUB_TOKEN=

# Supabase Management API token. Account-scoped, not project-scoped.
# Generate at: https://supabase.com/dashboard/account/tokens
SUPABASE_MANAGEMENT_TOKEN=

# Vercel API token. Generate at:
#   https://vercel.com/account/tokens
VERCEL_TOKEN=

# Railway API token (account-scoped). Generate at:
#   https://railway.app/account/tokens
RAILWAY_TOKEN=

# VAPI API key (private). From the VAPI dashboard → Account → API Keys.
VAPI_API_KEY=

# Mapbox token. Used by the dashboard's fleet map.
# Generate a public token at: https://account.mapbox.com/access-tokens/
MAPBOX_PUBLIC_TOKEN=

# ─────────────────────────────────────────────────────────
# Defaults — applied to every customer unless overridden by the
# `provisioning:` block in their customer-manifest.yaml.
# ─────────────────────────────────────────────────────────

# GitHub user or org that the per-customer fork lands under.
DEFAULT_GITHUB_OWNER=

# Supabase organization to create new projects in.
# Find at: https://supabase.com/dashboard/org/<id>/general
DEFAULT_SUPABASE_ORG_ID=

# Supabase region for new projects (e.g. us-east-1, us-west-1).
DEFAULT_SUPABASE_REGION=us-east-1

# Vercel team to create projects in. Leave blank for personal account.
DEFAULT_VERCEL_TEAM_ID=

# Railway team to create projects in. Leave blank for personal account.
DEFAULT_RAILWAY_TEAM_ID=

# Default area code for Twilio number-purchase suggestions in the runbook.
DEFAULT_TWILIO_AREA_CODE=

# ─────────────────────────────────────────────────────────
# Source repo — the template that gets forked per customer.
# ─────────────────────────────────────────────────────────
TEMPLATE_REPO_OWNER=brantlee-alexander
TEMPLATE_REPO_NAME=TrackHQ
